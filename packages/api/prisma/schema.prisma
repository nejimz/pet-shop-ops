generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

enum AppointmentType {
  CHECKUP
  VACCINE
  GROOMING
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedAppointments Appointment[] @relation("AssignedStaff")
  sales                Sale[]

  @@map("users")
}

model Owner {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets         Pet[]
  appointments Appointment[]
  visits       Visit[]
  sales        Sale[]

  @@index([name])
  @@index([phone])
  @@map("owners")
}

model Pet {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  species     String?
  breed       String?
  sex         PetSex?   @default(UNKNOWN)
  dateOfBirth DateTime?
  weight      Float?
  allergies   String?
  microchipId String?
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner        Owner         @relation(fields: [ownerId], references: [id])
  appointments Appointment[]
  visits       Visit[]
  sales        Sale[]

  @@index([name])
  @@index([ownerId])
  @@map("pets")
}

model Appointment {
  id             String            @id @default(cuid())
  ownerId        String
  petId          String
  assignedUserId String?
  startsAt       DateTime
  type           AppointmentType   @default(CHECKUP)
  reason         String?
  status         AppointmentStatus @default(SCHEDULED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  owner        Owner  @relation(fields: [ownerId], references: [id])
  pet          Pet    @relation(fields: [petId], references: [id])
  assignedUser User?  @relation("AssignedStaff", fields: [assignedUserId], references: [id])
  visit        Visit?

  @@index([startsAt])
  @@index([status])
  @@map("appointments")
}

model Visit {
  id                String    @id @default(cuid())
  appointmentId     String    @unique
  ownerId           String
  petId             String
  notes             String
  treatmentsSummary String?
  followUpAt        DateTime?
  occurredAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  owner       Owner       @relation(fields: [ownerId], references: [id])
  pet         Pet         @relation(fields: [petId], references: [id])

  @@index([ownerId, occurredAt])
  @@index([petId, occurredAt])
  @@map("visits")
}

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  price     Decimal
  stockQty  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleLines SaleLine[]

  @@index([name])
  @@map("products")
}

model Sale {
  id            String        @id @default(cuid())
  ownerId       String?
  walkInName    String?
  petId         String?
  paymentMethod PaymentMethod
  total         Decimal
  status        SaleStatus    @default(COMPLETED)
  soldByUserId  String
  occurredAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())

  owner  Owner?     @relation(fields: [ownerId], references: [id])
  pet    Pet?       @relation(fields: [petId], references: [id])
  soldBy User       @relation(fields: [soldByUserId], references: [id])
  lines  SaleLine[]

  @@index([ownerId, occurredAt])
  @@index([petId, occurredAt])
  @@index([occurredAt])
  @@map("sales")
}

model SaleLine {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_lines")
}
